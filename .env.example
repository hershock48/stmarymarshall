# Form delivery for every parish on the platform. SMTP through a mailbox the
# studio or a parish owns. Without these the forms still accept submissions
# and log the full payload; nothing is emailed. Set in the Vercel dashboard,
# never in a file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where a form goes when the parish's data.ts sets no `mailTo` of its own.
# The demo parishes set none on purpose, so nothing reaches a real office
# that has not asked for it.
MAIL_TO=

# The diocese layer. Every one of these is optional; the pages say what is
# off until it is set.
# Where a "Wrong time? Tell us" report from the finder goes; falls back to MAIL_TO.
DIOCESE_MAIL_TO=
# The chancery view's passcode (unset: the page is closed).
DIOCESE_PASSCODE=
# Neon Postgres for the counts (db/tally.sql once); unset: counting is a no-op.
DATABASE_URL=
# Cloudflare Stream customer code, for parishes with a `stream` live input in
# their data.ts; unset: /watch falls back to the parish's YouTube or Facebook.
STREAM_CUSTOMER_CODE=
