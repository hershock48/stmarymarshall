# Form delivery for every parish on the platform. SMTP through a mailbox the
# studio or a parish owns. Without these the forms still accept submissions
# and log the full payload; nothing is emailed. Set in the Vercel dashboard,
# never in a file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where a form goes when the parish's data.ts sets no `mailTo` of its own.
# The demo parishes set none on purpose, so nothing reaches a real office
# that has not asked for it.
MAIL_TO=
