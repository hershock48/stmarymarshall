# Registration form delivery. SMTP through a mailbox the parish owns.
# Without these the form still accepts submissions and logs the full
# payload; nothing is emailed. Set in the Vercel dashboard, never in a file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where registrations go. The parish office inbox.
MAIL_TO=
